# Copia este archivo como .env y completa los valores.

# Supabase Dashboard > Project Settings > Data API (Project URL)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase Dashboard > Project Settings > API Keys > Secret keys (sb_secret_...)
# ¡Solo en el backend! Nunca en el frontend ni en GitHub.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Orígenes permitidos por CORS, separados por coma (usa * para permitir todos)
CLIENT_ORIGIN=http://localhost:5173

# Puerto local (en Vercel se ignora)
PORT=3000
